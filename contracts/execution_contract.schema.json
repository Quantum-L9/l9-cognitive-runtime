{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "adapter_targets": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "authority_order": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "universal_execution_contract"
    },
    "execution_sequence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "kernel_activation": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "metadata": {
      "type": "object"
    },
    "objective": {
      "type": "string"
    },
    "output_contract": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_activation_plan": {
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "terminal_doctrine": {
      "type": "string"
    },
    "validation_requirements": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "execution_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution_step"
      }
    }
  },
  "required": [
    "contract_id",
    "contract_type",
    "source_activation_plan",
    "terminal_doctrine",
    "objective",
    "authority_order",
    "kernel_activation",
    "execution_sequence",
    "validation_requirements",
    "output_contract",
    "adapter_targets"
  ],
  "title": "L9 Universal Execution Contract",
  "type": "object",
  "$defs": {
    "obligation": {
      "type": "object",
      "required": [
        "obligation_id",
        "kind",
        "source_ref",
        "required",
        "owner",
        "consumer_refs",
        "evidence_requirements",
        "disposition"
      ],
      "properties": {
        "obligation_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "REALIZATION",
            "ARCHITECTURE",
            "VALIDATION",
            "DELIVERY",
            "AUTHORITY",
            "EPISTEMIC",
            "CONVERGENCE"
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "consumer_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disposition": {
          "enum": [
            "PENDING",
            "SATISFIED",
            "VALID_BLOCK",
            "SUPERSEDED_BY_HIGHER_AUTHORITY",
            "NOT_APPLICABLE_WITH_DETERMINISTIC_PROOF"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution_step": {
      "type": "object",
      "required": [
        "step_id",
        "phase",
        "kernel_refs",
        "obligation_refs",
        "input_refs",
        "output_refs",
        "entry_gates",
        "exit_gates",
        "evidence_requirements",
        "failure_routes"
      ],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "kernel_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "obligation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entry_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
