{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "adapter_notes": {
      "type": "object"
    },
    "contract_id": {
      "type": "string"
    },
    "contract_type": {
      "const": "handoff_contract"
    },
    "decisions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "handoff_summary": {
      "type": "string"
    },
    "loaded_context": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "next_action": {
      "type": "string"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    }
  },
  "required": [
    "contract_id",
    "contract_type",
    "handoff_summary",
    "loaded_context",
    "next_action",
    "unknowns"
  ],
  "title": "L9 Handoff Contract",
  "type": "object",
  "$defs": {
    "obligation": {
      "type": "object",
      "required": [
        "obligation_id",
        "kind",
        "source_ref",
        "required",
        "owner",
        "consumer_refs",
        "evidence_requirements",
        "disposition"
      ],
      "properties": {
        "obligation_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "REALIZATION",
            "ARCHITECTURE",
            "VALIDATION",
            "DELIVERY",
            "AUTHORITY",
            "EPISTEMIC",
            "CONVERGENCE"
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "consumer_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disposition": {
          "enum": [
            "PENDING",
            "SATISFIED",
            "VALID_BLOCK",
            "SUPERSEDED_BY_HIGHER_AUTHORITY",
            "NOT_APPLICABLE_WITH_DETERMINISTIC_PROOF"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
