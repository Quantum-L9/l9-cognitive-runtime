{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L9 Intent Contract",
  "type": "object",
  "required": [
    "intent_id",
    "mission",
    "task_type",
    "constraints",
    "desired_outputs",
    "objective",
    "accountability"
  ],
  "properties": {
    "intent_id": {
      "type": "string"
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_context": {
      "type": "object"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objective": {
      "type": "object",
      "required": [
        "requested",
        "realization_mode",
        "acceptance_conditions",
        "validation_required",
        "delivery_required",
        "delivery_mode"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "realization_mode": {
          "enum": [
            "MUTATION",
            "ARTIFACT",
            "ANALYSIS",
            "DECISION",
            "UNKNOWN"
          ]
        },
        "acceptance_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_required": {
          "type": "boolean"
        },
        "delivery_required": {
          "type": "boolean"
        },
        "delivery_mode": {
          "enum": [
            "RETURNED_ARCHIVE",
            "RETURNED_FILES",
            "PERSISTED_REPOSITORY",
            "IN_PLACE_WORKSPACE",
            "NONE"
          ]
        }
      },
      "additionalProperties": false
    },
    "accountability": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
