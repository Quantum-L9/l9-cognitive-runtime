{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L9 Execution Graph",
  "type": "object",
  "required": [
    "graph_id",
    "source_contract",
    "nodes",
    "edges",
    "terminal_node",
    "validation_gates"
  ],
  "properties": {
    "graph_id": {
      "type": "string"
    },
    "source_contract": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "kernel_refs",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "kernel_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "obligation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entry_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "terminal_node": {
      "type": "string"
    },
    "validation_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terminal_disposition": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
